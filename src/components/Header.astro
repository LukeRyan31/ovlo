---
const links = [
  { href: '/how-it-works', label: 'How it works' },
  { href: '/who-we-work-with', label: 'Who we work with' },
  { href: '/contact', label: 'Contact' },
]

const current = Astro.url.pathname.replace(/\/$/, '') || '/'
---

<header class="sticky top-0 z-50 border-b border-ink/10 bg-chalk">
  <nav
    aria-label="Main"
    class="mx-auto flex max-w-6xl items-center justify-between gap-2 px-4 py-4 sm:gap-4 sm:px-5 md:px-8"
  >
    <a
      href="/"
      class="font-[family-name:var(--font-wordmark)] text-xl font-extrabold tracking-tight text-ink sm:text-2xl"
      aria-label="Ovlo — home"
    >
      Ovlo
    </a>

    <ul class="flex items-center gap-0.5 text-sm sm:gap-1 sm:text-base md:gap-2">
      {
        links.map(({ href, label }) => (
          <li>
            <a
              href={href}
              aria-current={current === href ? 'page' : undefined}
              class:list={[
                'inline-block rounded px-1.5 py-2 font-medium transition-colors sm:px-2 md:px-3',
                current === href
                  ? 'text-copper-deep underline decoration-copper decoration-2 underline-offset-8'
                  : 'text-smoke hover:text-ink',
              ]}
            >
              <span class="hidden sm:inline">{label}</span>
              <span class="sm:hidden">
                {label === 'How it works' ? 'Method' : label === 'Who we work with' ? 'Who' : label}
              </span>
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</header>
