---
/**
 * Contact form posting to the existing Formspree endpoint.
 *
 * Progressive enhancement: without JavaScript the form performs a normal POST
 * and Formspree renders its own confirmation page. With JavaScript we
 * intercept, validate, and swap in an inline success panel.
 *
 * GDPR: submissions pass through Formspree. See /privacy — the transfer
 * mechanism for storage outside the EEA still needs to be confirmed before
 * this goes live.
 */
const FORMSPREE_ENDPOINT = 'https://formspree.io/f/xeewqkjj'

const fields = [
  {
    id: 'name',
    label: 'Name',
    type: 'text',
    autocomplete: 'name',
    required: true,
    placeholder: '',
  },
  {
    id: 'company',
    label: 'Company',
    type: 'text',
    autocomplete: 'organization',
    required: true,
    placeholder: '',
  },
  {
    id: 'role',
    label: 'Role',
    type: 'text',
    autocomplete: 'organization-title',
    required: true,
    placeholder: 'Finance Director, Financial Controller…',
  },
  {
    id: 'email',
    label: 'Email',
    type: 'email',
    autocomplete: 'email',
    required: true,
    placeholder: '',
  },
  {
    id: 'phone',
    label: 'Phone',
    type: 'tel',
    autocomplete: 'tel',
    required: false,
    placeholder: '',
  },
]

const inputClass =
  'w-full rounded-sm border border-ink/25 bg-chalk px-4 py-3 text-ink placeholder:text-smoke/60 transition-colors hover:border-ink/40 focus:border-copper-dark aria-[invalid=true]:border-red-700 aria-[invalid=true]:bg-red-50'
---

<div class="rounded-lg border border-ink/10 bg-sand p-6 md:p-10">
  <div id="form-panel">
    <p class="mb-8 rounded-sm border-l-4 border-copper bg-chalk p-4 text-base leading-relaxed">
      <strong class="font-semibold">Please do not attach statements to this form.</strong> Card
      processing statements are commercially sensitive and a web form is not the right way to move
      them. Send this, and we will reply with a secure upload link.
    </p>

    <form
      id="contact-form"
      action={FORMSPREE_ENDPOINT}
      method="POST"
      novalidate
      class="space-y-6"
    >
      <div class="grid gap-6 sm:grid-cols-2">
        {
          fields.map((f) => (
            <div class={f.id === 'role' ? 'sm:col-span-2' : ''}>
              <label for={f.id} class="mb-2 block text-base font-semibold text-ink">
                {f.label}
                {!f.required && <span class="ml-1 font-normal text-smoke">(optional)</span>}
              </label>
              <input
                type={f.type}
                id={f.id}
                name={f.id}
                autocomplete={f.autocomplete}
                placeholder={f.placeholder}
                required={f.required}
                aria-describedby={`${f.id}-error`}
                class={inputClass}
              />
              <p id={`${f.id}-error`} class="mt-1.5 hidden text-base font-medium text-red-800" />
            </div>
          ))
        }
      </div>

      <div>
        <label for="scale" class="mb-2 block text-base font-semibold text-ink">
          Number of sites, or approximate annual card volume
        </label>
        <input
          type="text"
          id="scale"
          name="scale"
          required
          placeholder="e.g. 22 sites, or around €40m"
          aria-describedby="scale-hint scale-error"
          class={inputClass}
        />
        <p id="scale-hint" class="mt-1.5 text-base text-smoke">
          A rough figure is fine. It tells us how long the audit is likely to take.
        </p>
        <p id="scale-error" class="mt-1.5 hidden text-base font-medium text-red-800"></p>
      </div>

      <div>
        <label for="message" class="mb-2 block text-base font-semibold text-ink">Message</label>
        <textarea
          id="message"
          name="message"
          rows="5"
          required
          aria-describedby="message-error"
          placeholder="Who you process with today, roughly how many merchant IDs you hold, and anything about your card costs that has prompted you to look at this."
          class={`${inputClass} resize-y`}></textarea>
        <p id="message-error" class="mt-1.5 hidden text-base font-medium text-red-800"></p>
      </div>

      {/* Spam honeypot — hidden from users and from assistive tech */}
      <input
        type="text"
        name="_gotcha"
        tabindex="-1"
        autocomplete="off"
        aria-hidden="true"
        class="absolute h-px w-px overflow-hidden opacity-0"
      />

      <div
        id="form-status"
        role="alert"
        aria-live="polite"
        class="hidden rounded-sm border-l-4 border-red-700 bg-red-50 p-4 text-base text-red-900"
      >
      </div>

      <button
        type="submit"
        id="submit-button"
        class="w-full rounded-sm bg-copper-dark px-8 py-4 text-lg font-semibold text-chalk transition-colors hover:bg-copper-deep disabled:cursor-not-allowed disabled:opacity-70 sm:w-auto"
      >
        Send
      </button>

      <p class="text-base leading-relaxed text-smoke">
        By sending this form you agree to us contacting you about your enquiry. We do not add you to
        a mailing list and we do not pass your details to anyone else. See our <a
          href="/privacy"
          class="prose-link">privacy policy</a
        >.
      </p>
    </form>
  </div>

  <!-- Success panel, revealed on a successful submission -->
  <div id="form-success" class="hidden" tabindex="-1">
    <h2 class="text-2xl font-semibold text-ink md:text-3xl">Thank you — we have your enquiry.</h2>
    <p class="mt-4 text-lg leading-relaxed">
      We will come back to you within one working day with secure upload instructions. If it is
      urgent, email us directly at <a href="mailto:hello@ovlo.ie" class="prose-link">hello@ovlo.ie</a
      >.
    </p>
  </div>
</div>

<script>
  const form = document.getElementById('contact-form') as HTMLFormElement | null
  if (form) {
    const panel = document.getElementById('form-panel')!
    const success = document.getElementById('form-success')!
    const status = document.getElementById('form-status')!
    const button = document.getElementById('submit-button') as HTMLButtonElement

    const rules: Record<string, (v: string) => string | null> = {
      name: (v) => (v.trim().length < 2 ? 'Please enter your name.' : null),
      company: (v) => (v.trim().length < 2 ? 'Please enter your company name.' : null),
      role: (v) => (v.trim().length < 2 ? 'Please enter your role.' : null),
      email: (v) =>
        !/^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/.test(v.trim())
          ? 'Please enter a valid email address.'
          : null,
      phone: (v) =>
        v.trim() && !/^[\d\s+()-]{7,}$/.test(v.trim()) ? 'Please enter a valid phone number.' : null,
      scale: (v) =>
        v.trim().length < 1 ? 'Please give us a rough number of sites or card volume.' : null,
      message: (v) =>
        v.trim().length < 20 ? 'Please tell us a little more — 20 characters or so.' : null,
    }

    const setError = (id: string, msg: string | null) => {
      const input = document.getElementById(id) as HTMLInputElement
      const slot = document.getElementById(`${id}-error`)!
      if (msg) {
        input.setAttribute('aria-invalid', 'true')
        slot.textContent = msg
        slot.classList.remove('hidden')
      } else {
        input.removeAttribute('aria-invalid')
        slot.textContent = ''
        slot.classList.add('hidden')
      }
      return !msg
    }

    const validateField = (id: string) => {
      const input = document.getElementById(id) as HTMLInputElement
      return setError(id, rules[id](input.value))
    }

    // Validate on blur, and clear the error as soon as the user fixes it
    Object.keys(rules).forEach((id) => {
      const input = document.getElementById(id) as HTMLInputElement
      input.addEventListener('blur', () => validateField(id))
      input.addEventListener('input', () => {
        if (input.getAttribute('aria-invalid') === 'true') validateField(id)
      })
    })

    form.addEventListener('submit', async (e) => {
      e.preventDefault()
      status.classList.add('hidden')

      const invalid = Object.keys(rules).filter((id) => !validateField(id))
      if (invalid.length) {
        const first = document.getElementById(invalid[0]) as HTMLInputElement
        first.focus()
        first.scrollIntoView({ block: 'center', behavior: 'smooth' })
        return
      }

      button.disabled = true
      button.textContent = 'Sending…'

      try {
        const res = await fetch(form.action, {
          method: 'POST',
          body: new FormData(form),
          headers: { Accept: 'application/json' },
        })

        if (res.ok) {
          panel.classList.add('hidden')
          success.classList.remove('hidden')
          success.focus()
          return
        }
        throw new Error(`Request failed with status ${res.status}`)
      } catch {
        status.innerHTML =
          'That did not send. Something went wrong at our end. Please try again, or email us directly at <a href="mailto:hello@ovlo.ie" class="prose-link">hello@ovlo.ie</a> and we will pick it up from there.'
        status.classList.remove('hidden')
        button.disabled = false
        button.textContent = 'Send'
      }
    })
  }
</script>
