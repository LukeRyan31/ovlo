---
import Base from '../layouts/Base.astro'
import ContactForm from '../components/ContactForm.astro'

const next = [
  'We reply within one working day with a secure upload link.',
  'You send one to three months of statements.',
  'Five working days later you get your audit.',
  'You decide what, if anything, you want to do next.',
]
---

<Base
  title="Contact — request a free statement audit — Ovlo"
  description="Get in touch to request a free card processing statement audit. Tell us about your estate and we will send secure upload instructions by reply. No obligation."
  path="/contact"
>
  <section class="border-b border-ink/10 bg-chalk">
    <div class="mx-auto max-w-6xl px-5 py-16 md:px-8 md:py-20">
      <h1 class="max-w-3xl text-4xl leading-[1.1] font-bold text-ink sm:text-5xl">Get in touch</h1>
      <p class="mt-6 max-w-[60ch] text-lg leading-relaxed md:text-xl">
        Tell us a little about your business and we will send you secure upload instructions by
        reply.
      </p>
      <p class="mt-5 max-w-[68ch] text-lg leading-relaxed text-smoke">
        Getting in touch does not commit you to anything. Sending us statements does not commit you
        to anything either. The audit is free, the analysis is yours to keep, and you are under no
        obligation to work with us afterwards.
      </p>
    </div>
  </section>

  <div class="mx-auto max-w-6xl px-5 py-16 md:px-8 md:py-20">
    <div class="grid gap-14 lg:grid-cols-[minmax(0,1fr)_20rem] lg:gap-20">
      <!-- ─── Form ─── -->
      <div>
        <ContactForm />
      </div>

      <!-- ─── Sidebar ─── -->
      <aside class="space-y-12">
        <section aria-labelledby="before">
          <h2 id="before" class="text-xl font-semibold text-ink">Before you send anything</h2>
          <dl class="mt-5 space-y-5">
            <div>
              <dt class="text-base font-semibold text-ink">What we will eventually need</dt>
              <dd class="mt-1.5 text-base leading-relaxed text-smoke">
                One to three months of statements covering every merchant ID you hold, in whatever
                format your provider issues. PDF or CSV is fine.
              </dd>
            </div>
            <div>
              <dt class="text-base font-semibold text-ink">How we treat them</dt>
              <dd class="mt-1.5 text-base leading-relaxed text-smoke">
                As confidential. We do not share them, we do not pass them to any acquirer or
                payment provider, and we do not use them as examples. We delete them once the audit
                is complete unless you ask us to hold them, and we delete them on request at any
                point.
              </dd>
            </div>
          </dl>
        </section>

        <section aria-labelledby="direct">
          <h2 id="direct" class="text-xl font-semibold text-ink">Direct contact</h2>
          <p class="mt-4">
            <a href="mailto:hello@ovlo.ie" class="prose-link text-lg font-semibold"
              >hello@ovlo.ie</a
            >
          </p>
          <p class="mt-3 text-base leading-relaxed text-smoke">
            We are based in Ireland and we work with Irish businesses.
          </p>
        </section>

        <section aria-labelledby="next" class="rounded-lg bg-parchment p-6">
          <h2 id="next" class="text-xl font-semibold text-ink">What happens next</h2>
          <ol class="mt-5 space-y-4">
            {
              next.map((step, i) => (
                <li class="flex gap-3">
                  <span
                    class="flex h-7 w-7 shrink-0 items-center justify-center rounded-full bg-copper-dark text-base font-bold text-chalk"
                    aria-hidden="true"
                  >
                    {i + 1}
                  </span>
                  <span class="text-base leading-relaxed text-smoke">{step}</span>
                </li>
              ))
            }
          </ol>
        </section>
      </aside>
    </div>
  </div>
</Base>
