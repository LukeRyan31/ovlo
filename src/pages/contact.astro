---
import Base from '../layouts/Base.astro'
import ContactDetails from '../components/ContactDetails.astro'
---

<Base
  title="Contact — request a free statement audit — Ovlo"
  description="Get in touch to request a free card processing statement audit. Email us about your estate and we will send secure upload instructions by reply. No obligation."
  path="/contact"
>
  <section class="border-b border-ink/10 bg-chalk">
    <div class="mx-auto max-w-6xl px-5 py-16 md:px-8 md:py-20">
      <h1 class="max-w-3xl text-4xl leading-[1.1] font-bold text-ink sm:text-5xl">Get in touch</h1>
      <p class="mt-6 max-w-[60ch] text-lg leading-relaxed md:text-xl">
        Tell us a little about your business and we will send you secure upload instructions by
        reply.
      </p>
      <p class="mt-5 max-w-[68ch] text-lg leading-relaxed text-smoke">
        Getting in touch does not commit you to anything. Sending us statements does not commit you
        to anything either. The audit is free, the analysis is yours to keep, and you are under no
        obligation to work with us afterwards.
      </p>
    </div>
  </section>

  <div class="mx-auto max-w-6xl px-5 py-16 md:px-8 md:py-20">
    <div class="grid gap-14 lg:grid-cols-[minmax(0,1fr)_20rem] lg:gap-20">
      <div>
        <ContactDetails as="h2" />
      </div>

      <aside class="space-y-12">
        <section aria-labelledby="before">
          <h2 id="before" class="text-xl font-semibold text-ink">What we will eventually need</h2>
          <p class="mt-4 text-base leading-relaxed text-smoke">
            One to three months of statements covering every merchant ID you hold, in whatever
            format your provider issues. PDF or CSV is fine.
          </p>
        </section>

        <section aria-labelledby="handling">
          <h2 id="handling" class="text-xl font-semibold text-ink">How we treat them</h2>
          <p class="mt-4 text-base leading-relaxed text-smoke">
            As confidential. We do not share them, we do not pass them to any acquirer or payment
            provider, and we do not use them as examples. We delete them once the audit is complete
            unless you ask us to hold them, and we delete them on request at any point.
          </p>
        </section>

        <section aria-labelledby="where">
          <h2 id="where" class="text-xl font-semibold text-ink">Where we are</h2>
          <p class="mt-4 text-base leading-relaxed text-smoke">
            Ireland. We work with Irish businesses.
          </p>
        </section>
      </aside>
    </div>
  </div>
</Base>
